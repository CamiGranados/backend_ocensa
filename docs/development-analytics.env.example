# Copiar a un gestor local de entorno; no versionar valores secretos.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://127.0.0.1:5285

Features__ImportPersistenceEnabled=true
Features__DatasetPublicationEnabled=false
Features__DevelopmentAnalyticsReadEnabled=true

# Proveer fuera de Git una cadena para una base SQL Server local/efimera.
ConnectionStrings__DefaultConnection=<LOCAL_SQL_SERVER_CONNECTION_STRING>

